# Project Environment Configuration
PROJECT_NAME="AlphaScribe AI"
DEBUG=True

# SQLite Database (handled automatically by config.py if omitted)
# DATABASE_URL="sqlite:///./data/app.db"

# LLM & Embedding API Keys
OPENAI_API_KEY="your-openai-api-key-here"
# Optional Anthropic / Google Keys if using alternative backends
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
# Set QDRANT_LOCATION=":memory:" or local path for embedded mode without Docker:
QDRANT_LOCATION="./data/qdrant_storage"

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="financial-analyst-agent"

# R Environment Path (optional, defaults to system 'Rscript')
RSCRIPT_PATH="Rscript"
